/// The expected 12-bit sample for pixel `p` and channel `c`
/// (c: 0 = R, 1 = G, 2 = B, 3 = A).
fn expected12(p : Int, c : Int) -> Int {
  let x = p % 16
  let y = p / 16
  if c == 0 {
    x * 256
  } else if c == 1 {
    y * 256
  } else if c == 2 {
    (x + y) * 128
  } else {
    x * 256 + y * 16
  }
}

/// The decoder's `scale_to_8` for 12-bit input (rounding `value*255/4095`).
fn scale12_to_8(v : Int) -> Int {
  if v <= 0 {
    0
  } else {
    let out = (v * 255 + 2047) / 4095
    if out > 255 { 255 } else { out }
  }
}

test "12-bit alpha is reconstructed at full precision, then quantized" {
  let s = decode_codestream_samples(jxl_12bit_alpha)
  assert_eq(s.width, 16)
  assert_eq(s.height, 16)
  assert_eq(s.bit_depth, 12)
  assert_eq(s.alpha_bit_depth, 12)

  // Full precision: every sample matches the known 12-bit ground truth.
  let num = 16 * 16
  let mut p = 0
  while p < num {
    let mut c = 0
    while c < 4 {
      let want = expected12(p, c)
      assert_eq(s.rgba[p * 4 + c], want)
      c = c + 1
    }
    p = p + 1
  }

  // 8-bit RGBA is exactly the quantization of the full-precision result.
  let img = decode_codestream(jxl_12bit_alpha)
  assert_eq(img.rgba.length(), num * 4)
  p = 0
  while p < num {
    let mut c = 0
    while c < 4 {
      let want = scale12_to_8(expected12(p, c))
      assert_eq(img.rgba[p * 4 + c], want)
      c = c + 1
    }
    p = p + 1
  }
}
