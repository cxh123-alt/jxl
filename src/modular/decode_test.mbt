///|
/// End-to-end lossless Modular decode regression: each fixture decodes to
/// the exact 8-bit RGBA produced by the reference `djxl` decoder (the
/// `.rgba` ground-truth files under `testdata/`).

fn first_mismatch(a : Array[Int], b : Bytes) -> Int {
  let n = a.length()
  let mut i = 0
  while i < n {
    if a[i] != b[i].to_int() {
      return i
    }
    i = i + 1
  }
  -1
}

