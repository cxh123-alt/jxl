test "decode 8x8_solid" {
  let img = decode_codestream(jxl_8x8_solid)
  assert_true(img.rgba.length() == ref_8x8_solid.length())
  let m = first_mismatch(img.rgba, ref_8x8_solid)
  if m != -1 {
    println("8x8_solid mismatch at \{m}: got \{img.rgba[m]}, want \{ref_8x8_solid[m].to_int()}")
  }
  assert_true(m == -1)
}

